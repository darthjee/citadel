# Backend framework settings
CITADEL_PLACEHOLDER_SECRET_KEY=citadel-placeholder-insecure-dev-only-change-in-production
# Comma-separated retired keys, still accepted for JWT verification during a key rotation
CITADEL_PLACEHOLDER_PREVIOUS_SECRET_KEYS=
CITADEL_PLACEHOLDER_ACCESS_TOKEN_TTL_MS=3600000
CITADEL_PLACEHOLDER_ALLOWED_ORIGINS=http://localhost:3000
CITADEL_PLACEHOLDER_LOG_LEVEL=info
NODE_ENV=development
DEBUG=true

# MySQL settings
CITADEL_PLACEHOLDER_MYSQL_HOST=mysql
CITADEL_PLACEHOLDER_MYSQL_PORT=3306
CITADEL_PLACEHOLDER_MYSQL_USER=citadel_placeholder
CITADEL_PLACEHOLDER_MYSQL_PASSWORD=citadel_placeholder
CITADEL_PLACEHOLDER_MYSQL_NAME=citadel_placeholder
CITADEL_PLACEHOLDER_DEMO_PASSWORD=citadel-placeholder-demo

# Email settings
CITADEL_PLACEHOLDER_EMAILS_ENABLED=false
CITADEL_PLACEHOLDER_EMAIL_HOST=localhost
CITADEL_PLACEHOLDER_EMAIL_PORT=587
CITADEL_PLACEHOLDER_EMAIL_USER=
CITADEL_PLACEHOLDER_EMAIL_PASSWORD=
CITADEL_PLACEHOLDER_EMAIL_USE_TLS=true
CITADEL_PLACEHOLDER_EMAIL_FROM=no-reply@citadel-placeholder.local
CITADEL_PLACEHOLDER_EMAIL_TIMEOUT_MS=10000
CITADEL_PLACEHOLDER_EMAIL_METHOD=native

# Frontend settings
FRONTEND_DEV_MODE=true
FRONTEND_BASE_URL=http://localhost:3000

# Cache warmer (Navi)
CITADEL_PLACEHOLDER_PRODUCTION_URL=http://localhost:3000
NAVI_NAMEPACE=default
